generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A piece of software licensed here. `slug` is what the program sends as `product` when it
/// activates, so a key issued for one software is refused by another.
model Product {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licenses License[]
  releases Release[]

  @@map("products")
}

/// A downloadable build of a software (the exe or installer), kept on the downloads volume.
model Release {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version   String
  filename  String
  size      Int
  sha256    String
  notes     String?
  downloads Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, createdAt(sort: Desc)])
  @@map("releases")
}

/// Who a licence is issued to: a company, studio or person. One customer can hold licences
/// for several softwares.
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licenses License[]

  @@index([name])
  @@map("customers")
}

/// A serial key issued to one customer for one software. Several computers may share it (maxSeats).
model License {
  id          String    @id @default(cuid())
  key         String    @unique
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Optional reference shown next to the customer: site, studio, invoice number.
  label       String?
  notes       String?
  /// active | locked | revoked
  status      String    @default("active")
  lockMessage String?
  maxSeats    Int       @default(1)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  systems System[]
  events  Event[]

  @@index([status])
  @@index([productId])
  @@index([customerId])
  @@map("licenses")
}

/// One computer activated against a licence. tokenHash is the SHA-256 of the activation token the program holds.
model System {
  id          String   @id @default(cuid())
  licenseId   String
  license     License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  machineId   String
  hostname    String?
  os          String?
  appVersion  String?
  ip          String?
  /// active | locked
  status      String   @default("active")
  lockMessage String?
  tokenHash   String
  /// online (activated with the key, checks in) | offline (holds a signed licence file)
  mode             String    @default("online")
  offlineExpiresAt DateTime?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([licenseId, machineId])
  @@index([lastSeenAt(sort: Desc)])
  @@map("systems")
}

/// Audit trail: who did what, and what the programs reported.
model Event {
  id        String   @id @default(cuid())
  licenseId String?
  license   License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  systemId  String?
  /// created | updated | extended | activated | deactivated | locked | unlocked | revoked | removed | refused | deleted | customer | software | file | release
  kind      String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([licenseId, createdAt(sort: Desc)])
  @@map("events")
}
