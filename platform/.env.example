# PostgreSQL. On Railway: ${{Postgres.DATABASE_URL}}?schema=licensing  (its own schema in the barpi database)
DATABASE_URL=postgresql://platform:platform@127.0.0.1:5432/platform?schema=licensing
# Password for the admin screens
PLATFORM_ADMIN_PASSWORD=change-me
# Signs the admin session cookie (16+ chars); changing it signs everyone out
PLATFORM_SESSION_SECRET=change-me-to-something-long
# Signs activation tokens handed to the programs; changing it makes every computer re-activate
LICENSE_SIGNING_SECRET=change-me-to-something-else-long
# Where the platform is reachable (used in links and shown to operators)
PUBLIC_URL=https://player.oncue.cy


# Offline licence files: RSA-2048 private key, base64 PKCS#8 DER (node deploy/keygen.mjs)
LICENSE_FILE_PRIVATE_KEY=
# Uploaded builds (a Railway volume mounted at /data in production)
DOWNLOADS_DIR=./data/downloads
